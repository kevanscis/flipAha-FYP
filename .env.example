# Flask
SECRET_KEY=change-me-to-a-random-string
FLASK_ENV=production

# Admin registration code
ADMIN_SECRET_CODE=CHANGE_ME

# LLM settings (defaults work out of the box via Pollinations free API)
# CLOUD_LLM_BASE_URL=https://text.pollinations.ai/openai
# CLOUD_LLM_MODEL=openai

# CORS – set to your production URL (e.g. https://flipaha.onrender.com)
# CORS_ORIGIN=https://flipaha.onrender.com

# Set to "true" on free-tier hosts to skip loading heavy ML models (saves ~1 GB RAM)
# The equation scanner feature will be unavailable, but chat tutor works fine.
LITE_MODE=true

# Render sets this automatically; no need to change
# PORT=5000
